# YouTube Video Data Analytics - Environment Variables
# Copy this file to .env and fill in your values
# The .env file is for sensitive data and should NOT be committed to git

# ==================== REQUIRED SETTINGS ====================

# YouTube Data API v3 Key
# Get it from: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# Default YouTube channel to analyze
DEFAULT_YOUTUBE_CHANNEL=your_channel_name_here

# ==================== OAUTH 2.0 SETTINGS ====================
# Required for YouTube Analytics API access (watch time, demographics, traffic sources)
# Get from Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Application type should be "Desktop app" or "Web application"
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8501

# ==================== OPTIONAL SETTINGS ====================

# Ollama configuration (for local LLM summarization)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b

# App defaults
DEFAULT_MAX_RESULTS=50
DEFAULT_ORDER=date

# Analytics thresholds (seconds)
SHORT_MAX_DURATION=60    # Videos under 60s are Shorts
LONG_MIN_DURATION=1800   # Videos over 30min are Long-form

# ==================== ADVANCED SETTINGS ====================

# Database configuration (future use)
# DATABASE_URL=sqlite:///youtube_analytics.db

# Cache configuration (future use)
# CACHE_TTL=3600

# Logging level
# LOG_LEVEL=INFO

# ==================== NOTES ====================
# 1. Never commit your .env file to version control
# 2. For production, use environment variables or a secure secret manager
# 3. The .env file takes precedence over config.py defaults
# 4. System environment variables take precedence over .env file